{
  "buildCommand": "npm run build",
  "outputDirectory": "app/frontend/dist",
  "framework": "vite",
  "functions": {
    "api/**/*.py": {
      "memory": 1024,
      "maxDuration": 15
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/synthetic/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/crops/(.*)",
      "destination": "/api/index.py"
    }
  ]
}

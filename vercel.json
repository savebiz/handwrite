{
  "buildCommand": "npm run build",
  "outputDirectory": "app/frontend/dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/synthetic/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/crops/(.*)",
      "destination": "/api/index.py"
    }
  ]
}

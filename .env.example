# HandWrite Verify — Environment Variables

APP_ENV=development
API_PORT=8000
FRONTEND_PORT=5173
LOG_LEVEL=INFO

# Optional Vision Model Key (if using remote vision API; fallback to local PIL/OCR stub)
VISION_API_KEY=your_api_key_here
VISION_MODEL=gemini-2.5-flash

# Optional Supabase Database Key (for Vercel/serverless deployments; fallback to local file store)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your_anon_or_service_role_key

